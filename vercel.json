{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node", "config": { "maxDuration": 60 } }
  ],
  "routes": [
    { "src": "/v1/(.*)", "dest": "/api/index.js" },
    { "src": "/models", "dest": "/api/index.js" },
    { "src": "/admin(.*)", "dest": "/api/index.js" },
    { "src": "/(.*)", "dest": "/api/index.js" }
  ]
}